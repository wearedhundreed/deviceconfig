	<key>PayloadDisplayName</key>
	<string>secure-password-manager.com iCloud Mail</string>
	<key>PayloadDescription</key>
	<string>Adds the secure-password-manager.com iCloud Mail account with user-selectable S/MIME signing and encryption.</string>
	<key>PayloadOrganization</key>
	<string>wearedhundreed</string>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.mail.managed</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.wearedhundreed.icloud.secure-password-manager.smime.mail</string>
			<key>PayloadUUID</key>
			<string>78965307-C9F9-5E87-91E9-562C007DC93F</string>
			<key>PayloadDisplayName</key>
			<string>secure-password-manager.com Mail</string>
			<key>PayloadDescription</key>
			<string>Configures iCloud IMAP and SMTP for secure-password-manager.com.</string>
			<key>PayloadOrganization</key>
			<string>wearedhundreed</string>
			<key>EmailAccountDescription</key>
			<string>secure-password-manager.com iCloud Mail</string>
			<key>EmailAccountType</key>
			<string>EmailTypeIMAP</string>
			<key>IncomingMailServerAuthentication</key>
			<string>EmailAuthPassword</string>
			<key>IncomingMailServerHostName</key>
			<string>imap.mail.me.com</string>
			<key>IncomingMailServerPortNumber</key>
			<integer>993</integer>
			<key>IncomingMailServerUseSSL</key>
			<true/>
			<key>OutgoingMailServerAuthentication</key>
			<string>EmailAuthPassword</string>
			<key>OutgoingMailServerHostName</key>
			<string>smtp.mail.me.com</string>
			<key>OutgoingMailServerPortNumber</key>
			<integer>587</integer>
			<key>OutgoingMailServerUseSSL</key>
			<true/>
			<key>OutgoingPasswordSameAsIncomingPassword</key>
			<true/>
			<key>SMIMESigningEnabled</key>
			<false/>
			<key>SMIMESigningUserOverrideable</key>
			<true/>
			<key>SMIMESigningCertificateUUIDUserOverrideable</key>
			<true/>
			<key>SMIMEEncryptByDefault</key>
			<false/>
			<key>SMIMEEncryptByDefaultUserOverrideable</key>
			<true/>
			<key>SMIMEEnableEncryptionPerMessageSwitch</key>
